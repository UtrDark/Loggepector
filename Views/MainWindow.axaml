<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Loggepector.ViewModels"
        xmlns:views="using:Loggepector.Views"
        xmlns:rs="using:RangeSlider.Avalonia.Controls"
        x:Class="Loggepector.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="720" MinWidth="650" MinHeight="400"
        Icon="/Assets/avalonia-logo.ico"
        Title="Loggepector">
    <Window.Styles>
        <Style Selector="ToggleButton.badgeExclude:checked">
            <Setter Property="Foreground" Value="IndianRed" />
            <Setter Property="BorderBrush" Value="IndianRed" />
        </Style>
        <Style Selector="FlyoutPresenter.resources">
            <Setter Property="MaxWidth" Value="440" />
        </Style>
        <Style Selector="FlyoutPresenter.resources /template/ ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="FlyoutPresenter.rawLog">
            <Setter Property="MaxWidth" Value="680" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="FlyoutPresenter.rawLog /template/ ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Window.Styles>
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="0,0,0,6">
            <Button Content="Открыть .log" Click="OpenLogFile" IsEnabled="{Binding CanOpenFile}" />
            <Button Grid.Column="1" x:Name="BigLogButton" Content="Open big log" IsEnabled="{Binding CanOpenFile}" Margin="8,0,0,0">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="6">
                            <Button Content="Папка раунда…" Click="OpenBigLogFolder" />
                            <Button Content="Архив .7z…" Click="OpenBigLogArchive" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Grid.Column="2" Content="{Binding LogisButtonText}" Click="ConnectLogis" IsEnabled="{Binding CanOpenFile}" Margin="8,0,0,0" />
            <Button Grid.Column="3" Content="Выбрать репу ▾" Click="RefreshResources" Margin="8,0,0,0" IsEnabled="{Binding CanOpenFile}">
                <Button.Flyout>
                    <Flyout FlyoutPresenterClasses="resources">
                        <StackPanel Width="400" Spacing="8" IsEnabled="{Binding !IsResourcesBusy}">
                            <TextBlock Text="Репозиторий станции" />
                            <TextBox Text="{Binding MapRepositoryUrl}" Watermark="https://github.com/owner/repository" />
                            <Button Content="Сохранить" Command="{Binding SaveRepositoryCommand}" />
                            <Button Content="Удалить инструменты карт" Click="DeleteMapResources" IsVisible="{Binding HasMapResources}" IsEnabled="{Binding !IsMapToolsBusy}" />
                            <Button Content="Удалить CSS Roundend" Command="{Binding DeleteRoundEndResourcesCommand}" IsVisible="{Binding HasRoundEndResources}" />
                            <Button Content="Удалить смайлики" Command="{Binding DeleteEmojiResourcesCommand}" IsVisible="{Binding HasEmojiResources}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <TextBlock Grid.Column="4" Text="{Binding FileName}" Margin="16,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="5" Content="Roundend" Click="OpenRoundEnd" IsVisible="{Binding HasRoundEnd}"
                    IsEnabled="{Binding CanOpenFile}" Margin="8,0,0,0" />
            <Button Grid.Column="6" Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}"
                    Width="34" Height="32" Padding="0" FontSize="20" HorizontalContentAlignment="Center"
                    ToolTip.Tip="Сменить тему" Margin="12,0,0,0" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsLoading}" Margin="0,0,0,12">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadProgress}" Height="6"
                         VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding LoadProgress, StringFormat='{}{0}%'}" Margin="12,0,0,0" />
            <Button Grid.Column="2" Content="Отмена" Command="{Binding CancelLoadCommand}" Margin="12,0,0,0" />
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="IndianRed" IsVisible="{Binding HasErrorMessage}"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding TimeLabel}" />
            <Button Grid.Column="1" Click="OpenUpdateRelease" IsVisible="{Binding HasUpdate}"
                    Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding UpdateCheckStatus}">
                <TextBlock Text="Доступно обновление" Foreground="{Binding UpdateNoticeColor}" FontSize="11" TextDecorations="Underline" />
            </Button>
            <TextBlock Grid.Column="1" Text="Не удалось проверить обновления" FontSize="11" Opacity="0.65"
                       VerticalAlignment="Center" IsVisible="{Binding UpdateCheckFailed}" ToolTip.Tip="{Binding UpdateCheckStatus}" />
        </Grid>
        <Grid Grid.Row="4" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2,0,6">
            <Button Content="↺" Command="{Binding ResetTimeSliceCommand}" Padding="6,0"
                    ToolTip.Tip="Весь лог" IsEnabled="{Binding CanSelectTime}" />
        <rs:RangeSlider Grid.Column="1" Minimum="0" Maximum="{Binding SliderMaximum}"
                        LowerSelectedValue="{Binding FromSecond, Mode=TwoWay}"
                        UpperSelectedValue="{Binding ToSecond, Mode=TwoWay}"
                        TickFrequency="1" IsSnapToTickEnabled="True" IsThumbOverlap="True"
                        IsEnabled="{Binding CanSelectTime}" />
        </Grid>

        <StackPanel Grid.Row="5" Margin="0,0,0,6" Spacing="4">
            <DockPanel LastChildFill="False" HorizontalAlignment="Left">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
                <Button Content="Типы ▾" IsEnabled="{Binding CanOpenFile}">
                    <Button.Flyout>
                        <Flyout>
                            <Grid RowDefinitions="Auto,*" RowSpacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Снять все" Command="{Binding ClearTypeFiltersCommand}" Padding="6,2" />
                                    <Button Content="IC" Command="{Binding FilterIcCommand}" Padding="8,2" />
                                    <Button Content="OOC" Command="{Binding FilterOocCommand}" Padding="8,2" />
                                </StackPanel>
                            <ScrollViewer Grid.Row="1" MaxHeight="320">
                                <ItemsControl ItemsSource="{Binding LogTypes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LogTypeViewModel">
                                            <Button Command="{Binding CycleFilterCommand}" Background="Transparent"
                                                    BorderThickness="0" Padding="2,3" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left" ToolTip.Tip="{Binding FilterDescription}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Width="20" Height="20" CornerRadius="3" BorderThickness="1"
                                                            BorderBrush="{Binding FilterColor}">
                                                        <TextBlock Text="{Binding FilterMark}" Foreground="{Binding FilterColor}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" Foreground="{Binding TypeColor}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Content="Filter" Click="OpenSearch" />
                <Button Content="PlayersInfo" Click="OpenPlayersInfo" IsEnabled="{Binding CanShowPlayersInfo}" />
                <Button Content="MapView" Click="OpenMapView" IsEnabled="{Binding CanOpenMap}" />
            </StackPanel>
            <Button IsEnabled="{Binding CanOpenFile}" HorizontalAlignment="Left" MaxWidth="260"
                    HorizontalContentAlignment="Left" Margin="8,0,0,0" Height="30" MinHeight="0" Padding="8,2">
                <TextBlock Text="{Binding PlayerLabel}" TextTrimming="CharacterEllipsis" />
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="320" Spacing="8">
                            <TextBox Text="{Binding PlayerSearchText, Mode=TwoWay}" Watermark="Найти ckey игрока…" />
                            <TextBlock Text="Выберите игроков. Пустой выбор — все." Opacity="0.65" />
                            <ScrollViewer MaxHeight="280">
                                <ItemsControl ItemsSource="{Binding FilteredPlayers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlayerViewModel">
                                            <CheckBox Content="{Binding CKey}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Content="Forbidden" Command="{Binding FilterForbiddenCommand}" IsVisible="{Binding HasForbidden}"
                    IsEnabled="{Binding CanOpenFile}" Margin="8,0,0,0" ToolTip.Tip="Фильтровать по типу FORBIDDEN" />
            <CheckBox Content="Sanitize" IsChecked="{Binding Sanitize, Mode=TwoWay}" Margin="12,0,0,0" />
            <CheckBox Content="Relative" IsChecked="{Binding Relative, Mode=TwoWay}" Margin="12,0,0,0" />
            <CheckBox Content="Show raw" IsChecked="{Binding ShowRaw, Mode=TwoWay}" Margin="12,0,0,0" />
            <CheckBox Content="Show area" IsChecked="{Binding ShowArea, Mode=TwoWay}" Margin="12,0,0,0" />
            </DockPanel>
            <WrapPanel>
                <CheckBox Content="Соседние" IsChecked="{Binding CaptureSameType, Mode=TwoWay}" Margin="0,0,8,0" />
                <NumericUpDown Value="{Binding NeighborCount, Mode=TwoWay}" Minimum="0" Maximum="100"
                               Increment="1" FormatString="0" Width="100" Margin="0,0,12,0" />
                <CheckBox Content="Радиус" IsChecked="{Binding CaptureByCoordinates, Mode=TwoWay}" Margin="0,0,8,0" />
                <NumericUpDown Value="{Binding CoordinateRadius, Mode=TwoWay}" Minimum="0" Maximum="255"
                               Increment="1" FormatString="0" Width="100" Margin="0,0,12,0" />
            </WrapPanel>
            <TextBlock Text="{Binding ContextStatus}" IsVisible="{Binding HasContextStatus}" Opacity="0.65" />
            <Border IsVisible="{Binding IsSearchVisible}" BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="4,2" Background="{DynamicResource AppPanelBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                    <ItemsControl ItemsSource="{Binding SearchBadges}" MaxWidth="650" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchBadgeViewModel">
                                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" Spacing="2">
                                    <ToggleButton Content="!" Classes="badgeExclude" IsChecked="{Binding IsExcluded, Mode=OneWay}"
                                                  Padding="4,0" MinHeight="0" Height="24"
                                                  ToolTip.Tip="Исключать записи с этой плашкой"
                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleSearchBadgeExclusionCommand}"
                                                  CommandParameter="{Binding}" />
                                    <views:LogMessageTextBlock Parts="{Binding Parts}" AllowTextSelection="False" VerticalAlignment="Center" />
                                    <Button Content="×" Padding="3,0" MinHeight="0" Height="24"
                                            ToolTip.Tip="Убрать плашку из поиска"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveSearchBadgeCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Grid.Column="1" x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay}"
                             MinWidth="80" BorderThickness="0" Background="Transparent" />
                    <ToggleButton Grid.Column="2" Content="Fuzzy" IsChecked="{Binding FuzzySearch, Mode=TwoWay}"
                                  ToolTip.Tip="Искать частичные совпадения" Padding="8,2" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="6">
            <ListBox x:Name="LogsList" ItemsSource="{Binding Logs}" SelectedItems="{Binding SelectedLogs, Mode=OneWay}" SelectionMode="Multiple" AutoScrollToSelectedItem="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.AllowAutoHide="False" Padding="0">
                <ListBox.Styles>
                    <Style Selector="ScrollViewer">
                        <Setter Property="BringIntoViewOnFocusChange" Value="False" />
                    </Style>
                    <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="30" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogEntryViewModel">
                        <Grid RowDefinitions="30,Auto" Background="{Binding RowBackground}">
                            <Border Grid.RowSpan="2" Background="{Binding AlternateRowOverlay}" IsVisible="{Binding IsAlternate}"
                                    IsHitTestVisible="False" />
                            <Border Grid.RowSpan="2" Background="#24E6B800" IsVisible="{Binding IsFindMatch}" IsHitTestVisible="False" />
                            <Border Grid.RowSpan="2" BorderBrush="#D6A500" BorderThickness="2" IsVisible="{Binding IsCurrentFindMatch}"
                                    IsHitTestVisible="False" />
                            <Grid ColumnDefinitions="110,120,*,Auto,Auto,Auto" Margin="8,0,2,0">
                                <views:LogMessageTextBlock Parts="{Binding TimeParts}" AllowTextSelection="False" Focusable="False"
                                           HighlightText="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ActiveFindText}"
                                           VerticalAlignment="Center" Opacity="0.65" />
                                <views:LogMessageTextBlock Grid.Column="1" Parts="{Binding TypeParts}" FontWeight="SemiBold"
                                           AllowTextSelection="False" Focusable="False"
                                           HighlightText="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ActiveFindText}"
                                           Foreground="{Binding TypeColor}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <views:LogMessageTextBlock Grid.Column="2" Parts="{Binding MessageParts}" TextWrapping="NoWrap"
                                           HighlightText="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ActiveFindText}"
                                           AllowTextSelection="False"
                                           IsTruncated="{Binding IsTextClipped, Mode=TwoWay}"
                                           BadgeSearchCommand="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SearchBadgeCommand}"
                                           Focusable="False"
                                           VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="3" Content="⌖" IsVisible="{Binding HasCoordinates}"
                                        Click="ShowLogOnMap" Margin="8,0,0,0" Padding="6,2" Height="24" MinHeight="0" VerticalAlignment="Center" />
                                <Button Grid.Column="4" Name="ExpandDetailsButton" Content="{Binding ExpandLabel}"
                                              IsVisible="{Binding CanExpand}"
                                              Click="ToggleLogDetails"
                                              Margin="8,0,0,0" Padding="8,2" Height="24" MinHeight="0" VerticalAlignment="Center"
                                              ToolTip.Tip="Развернуть или свернуть запись" />
                                <Button Grid.Column="5" Content="RAW" Margin="8,0,0,0" Padding="6,2" Height="24"
                                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowRaw}"
                                        MinHeight="0" VerticalAlignment="Center" ToolTip.Tip="Исходная строка лога">
                                    <Button.Flyout>
                                        <Flyout FlyoutPresenterClasses="rawLog">
                                            <ScrollViewer MaxWidth="640" MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                                                <SelectableTextBlock Text="{Binding RawMessage}" TextWrapping="Wrap" />
                                            </ScrollViewer>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <Border Grid.Row="1" IsVisible="{Binding IsExpanded}" Padding="8"
                                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorderBrush}">
                                <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                                    <views:LogMessageTextBlock Parts="{Binding MessageParts}" TextWrapping="Wrap"
                                        HighlightText="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ActiveFindText}"
                                        BadgeSearchCommand="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SearchBadgeCommand}" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <views:FindOverview Positions="{Binding FindPositions}" CurrentPosition="{Binding CurrentFindPosition}"
                                IsVisible="{Binding IsFindVisible}" Width="8" HorizontalAlignment="Right"
                                Margin="0,16,2,16" IsHitTestVisible="False" />
            <Border IsVisible="{Binding IsFindVisible}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="8" Padding="8" CornerRadius="4" Background="{DynamicResource AppPanelBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="220,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                    <TextBox x:Name="FindBox" Text="{Binding FindText, Mode=TwoWay}" />
                    <TextBlock Grid.Column="1" Text="{Binding FindCounter}" MinWidth="54" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="↑" Command="{Binding PreviousFindCommand}" ToolTip.Tip="Предыдущая запись · Shift+Enter" />
                    <Button Grid.Column="3" Content="↓" Command="{Binding NextFindCommand}" ToolTip.Tip="Следующая запись · Enter" />
                    <Button Grid.Column="4" Content="×" Command="{Binding CloseFindCommand}" ToolTip.Tip="Закрыть · Esc" />
                </Grid>
            </Border>
            <TextBlock Text="Нет записей" IsVisible="{Binding IsEmpty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       Opacity="0.6" />
            <Border IsVisible="{Binding IsCopyNoticeVisible}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="12" Padding="14,8" CornerRadius="5" Background="{DynamicResource AppPanelBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" IsHitTestVisible="False">
                <TextBlock Text="Скопировано" />
            </Border>
        </Grid>

        <TextBlock Grid.Row="7" Text="{Binding CountLabel}" Margin="0,4,0,0" Opacity="0.65" />

    </Grid>
</Window>
