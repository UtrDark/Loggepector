<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Loggepector.ViewModels"
        xmlns:rs="using:RangeSlider.Avalonia.Controls"
        x:Class="Loggepector.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="720" MinWidth="650" MinHeight="400"
        Icon="/Assets/avalonia-logo.ico"
        Title="Loggepector">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">
        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,16">
            <Button Content="Открыть .log" Click="OpenLogFile" IsEnabled="{Binding CanOpenFile}" />
            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="16,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" IsVisible="{Binding IsLoading}" Margin="0,0,0,12">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadProgress}" Height="6"
                         VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding LoadProgress, StringFormat='{}{0}%'}" Margin="12,0,0,0" />
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="IndianRed"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Grid.Row="3" Text="{Binding TimeLabel}" />
        <rs:RangeSlider Grid.Row="4" Minimum="0" Maximum="{Binding SliderMaximum}"
                        LowerSelectedValue="{Binding FromSecond, Mode=TwoWay}"
                        UpperSelectedValue="{Binding ToSecond, Mode=TwoWay}"
                        TickFrequency="1" IsSnapToTickEnabled="True" IsThumbOverlap="True"
                        IsEnabled="{Binding CanSelectTime}" Margin="0,8,0,16" />

        <StackPanel Grid.Row="5" Margin="0,0,0,12" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Типы ▾" IsEnabled="{Binding CanOpenFile}">
                    <Button.Flyout>
                        <Flyout>
                            <ScrollViewer MaxHeight="320">
                                <ItemsControl ItemsSource="{Binding LogTypes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LogTypeViewModel">
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Content="Поиск · Ctrl+F" Click="OpenSearch" />
                <Button Content="PlayersInfo" Click="OpenPlayersInfo" IsEnabled="{Binding CanShowPlayersInfo}" />
                <Button Content="MapView" Click="OpenMapView" IsEnabled="{Binding CanOpenMap}" ToolTip.Tip="{Binding MapName}" />
            </StackPanel>
            <Button IsEnabled="{Binding CanOpenFile}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left">
                <TextBlock Text="{Binding PlayerLabel}" TextTrimming="CharacterEllipsis" />
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="320" Spacing="8">
                            <TextBox Text="{Binding PlayerSearchText, Mode=TwoWay}" Watermark="Найти ckey игрока…" />
                            <TextBlock Text="Выберите игроков. Пустой выбор — все." Opacity="0.65" />
                            <ScrollViewer MaxHeight="280">
                                <ItemsControl ItemsSource="{Binding FilteredPlayers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlayerViewModel">
                                            <CheckBox Content="{Binding CKey}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsSearchVisible}">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="Поиск по тексту в выбранном диапазоне" />
                <Button Grid.Column="1" Content="Закрыть · Esc" Click="CloseSearch" Margin="8,0,0,0" />
            </Grid>
        </StackPanel>

        <Grid Grid.Row="6">
            <ListBox x:Name="LogsList" ItemsSource="{Binding Logs}" AutoScrollToSelectedItem="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ScrollViewer">
                        <Setter Property="BringIntoViewOnFocusChange" Value="False" />
                    </Style>
                    <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="44" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogEntryViewModel">
                        <Grid RowDefinitions="44,Auto" Background="{Binding RowBackground}">
                            <Grid ColumnDefinitions="110,120,Auto,*,Auto" Margin="8,0">
                                <TextBlock Text="{Binding Entry.Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}"
                                           VerticalAlignment="Center" Opacity="0.65" />
                                <TextBlock Grid.Column="1" Text="{Binding Entry.Type}" FontWeight="SemiBold"
                                           Foreground="{Binding TypeColor}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding ChannelLabel}" Foreground="{Binding ChannelColor}"
                                           IsVisible="{Binding HasChannel}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="NoWrap"
                                           VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="4" Content="{Binding ExpandLabel}"
                                              IsVisible="{Binding IsMultiline}"
                                              Click="ToggleLogDetails"
                                              Margin="8,0,0,0" Padding="8,2" VerticalAlignment="Center"
                                              ToolTip.Tip="Развернуть или свернуть запись" />
                            </Grid>
                            <Border Grid.Row="1" IsVisible="{Binding IsExpanded}" Padding="8"
                                    BorderThickness="0,1,0,0" BorderBrush="Gray">
                                <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                                    <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Нет записей по выбранным фильтрам" IsVisible="{Binding IsEmpty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       Opacity="0.6" />
        </Grid>

        <TextBlock Grid.Row="7" Text="{Binding CountLabel}" Margin="0,12,0,0" Opacity="0.65" />
        <StackPanel Grid.Row="8" Spacing="8">
            <Border IsVisible="{Binding IsMapToolsPromptVisible}" Padding="12" BorderBrush="Gray" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Скачать инструменты и исходники BandaStation для рендера карт?"
                               TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="Карты будут подготовлены в фоне. Загрузка может быть большой; выбор сохранится рядом с exe."
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Скачать и подготовить" Command="{Binding EnableMapToolsCommand}" />
                        <Button Content="Продолжить без карт" Command="{Binding DisableMapToolsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding MapToolsStatus}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
