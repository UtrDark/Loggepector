<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Loggepector.ViewModels"
        xmlns:models="using:Loggepector.Models"
        xmlns:rs="using:RangeSlider.Avalonia.Controls"
        x:Class="Loggepector.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="720" MinWidth="650" MinHeight="400"
        Icon="/Assets/avalonia-logo.ico"
        Title="Loggepector">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,16">
            <Button Content="Открыть .log" Click="OpenLogFile" IsEnabled="{Binding CanOpenFile}" />
            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="16,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" IsVisible="{Binding IsLoading}" Margin="0,0,0,12">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadProgress}" Height="6"
                         VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding LoadProgress, StringFormat='{}{0}%'}" Margin="12,0,0,0" />
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="IndianRed"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Grid.Row="3" Text="{Binding TimeLabel}" />
        <rs:RangeSlider Grid.Row="4" Minimum="0" Maximum="{Binding SliderMaximum}"
                        LowerSelectedValue="{Binding FromSecond, Mode=TwoWay}"
                        UpperSelectedValue="{Binding ToSecond, Mode=TwoWay}"
                        TickFrequency="1" IsSnapToTickEnabled="True" IsThumbOverlap="True"
                        IsEnabled="{Binding CanSelectTime}" Margin="0,8,0,16" />

        <StackPanel Grid.Row="5" Margin="0,0,0,12" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Типы ▾" IsEnabled="{Binding CanOpenFile}">
                    <Button.Flyout>
                        <Flyout>
                            <ScrollViewer MaxHeight="320">
                                <ItemsControl ItemsSource="{Binding LogTypes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LogTypeViewModel">
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Content="Поиск · Ctrl+F" Click="OpenSearch" />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsSearchVisible}">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="Поиск по тексту в выбранном диапазоне" />
                <Button Grid.Column="1" Content="Закрыть · Esc" Click="CloseSearch" Margin="8,0,0,0" />
            </Grid>
        </StackPanel>

        <Grid Grid.Row="6">
            <ListBox ItemsSource="{Binding Logs}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:LogEntry">
                        <Grid ColumnDefinitions="110,120,*" Margin="4,6">
                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}"
                                       Opacity="0.65" />
                            <TextBlock Grid.Column="1" Text="{Binding Type}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Нет записей по выбранным фильтрам" IsVisible="{Binding IsEmpty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       Opacity="0.6" />
        </Grid>

        <TextBlock Grid.Row="7" Text="{Binding CountLabel}" Margin="0,12,0,0" Opacity="0.65" />
    </Grid>
</Window>
