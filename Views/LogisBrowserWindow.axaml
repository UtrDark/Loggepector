<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Loggepector.ViewModels"
        xmlns:models="using:Loggepector.Models"
        x:Class="Loggepector.Views.LogisBrowserWindow" x:DataType="vm:LogisBrowserViewModel"
        Title="Логи Logis" Width="720" Height="540" MinWidth="540" MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsEnabled="{Binding CanSelect}">
            <StackPanel Spacing="6">
                <TextBlock Text="Сервер" />
                <ComboBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                          HorizontalAlignment="Stretch" PlaceholderText="Выберите сервер" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="День" />
                <CalendarDatePicker SelectedDate="{Binding SelectedCalendarDate, Mode=TwoWay}"
                                    DisplayDate="{Binding CalendarDisplayDate, Mode=OneWay}"
                                    DisplayDateStart="{Binding FirstDate}" DisplayDateEnd="{Binding LastDate}"
                                    SelectedDateFormat="Custom" CustomDateFormatString="dd.MM.yyyy"
                                    Watermark="Выберите день" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
        <TextBox Grid.Row="1" Text="{Binding RoundSearchText}"
                 IsEnabled="{Binding CanSelect}" />
        <TextBlock Grid.Row="2" Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
        <ListBox x:Name="RoundsList" Grid.Row="4" ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog}"
                 IsEnabled="{Binding CanSelect}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:LogisLogFile">
                    <TextBlock Text="{Binding DisplayName}" Margin="6" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ProgressBar Grid.Row="5" IsIndeterminate="{Binding !IsDownloading}" Value="{Binding DownloadProgress}"
                     IsVisible="{Binding HasProgress}" Height="6" Minimum="0" Maximum="100" />
        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="Войти заново" Command="{Binding ReauthenticateCommand}" IsVisible="{Binding IsSessionExpired}" />
            <Button Content="Открыть game.log" Command="{Binding DownloadCommand}" />
        </StackPanel>
    </Grid>
</Window>
