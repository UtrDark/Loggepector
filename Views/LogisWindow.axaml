<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Loggepector.ViewModels"
        x:Class="Loggepector.Views.LogisWindow" x:DataType="vm:LogisViewModel"
        Title="Подключить Logis" Width="720" Height="290" MinWidth="620" MinHeight="290"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsLoginOpen}">
            <TextBox Text="{Binding Address}" Watermark="HTTPS-адрес сервера Logis" />
            <Button Grid.Column="1" Content="OK" Command="{Binding ContinueCommand}" Margin="12,0,0,0" />
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="{Binding IsLoginOpen}">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            <Button Grid.Row="1" Content="Открыть окно входа" Click="OpenNativeLogin"
                    IsEnabled="{Binding !IsBrowserOpen}" VerticalAlignment="Top" />
        </Grid>
    </Grid>
</Window>
