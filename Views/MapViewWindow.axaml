<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Loggepector.ViewModels"
        xmlns:views="using:Loggepector.Views"
        xmlns:rs="using:RangeSlider.Avalonia.Controls"
        x:Class="Loggepector.Views.MapViewWindow"
        x:DataType="vm:MapViewModel"
        Title="{Binding MapName, StringFormat='MapView · {0}'}"
        Width="1200" Height="850" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="FlyoutPresenter.mapTools">
            <Setter Property="MaxWidth" Value="480" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="FlyoutPresenter.mapTools /template/ ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*">
        <Border Padding="16,10" Background="{DynamicResource AppPanelBrush}">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsEnabled="{Binding !IsRemovingMapTools}">
                    <ComboBox ItemsSource="{Binding AvailableMaps}" SelectedItem="{Binding MapName, Mode=TwoWay}"
                              PlaceholderText="Выберите карту" MinWidth="180" HorizontalAlignment="Left"
                              IsEnabled="{Binding !Timeline.IsMapToolsBusy}" />
                    <Button Grid.Column="1" Content="Инструменты карт ▾" Click="RefreshMapToolsState">
                        <Button.Flyout>
                            <Flyout FlyoutPresenterClasses="mapTools">
                                <StackPanel Width="440" Spacing="10" IsEnabled="{Binding !IsRemovingMapTools}">
                                    <TextBlock Text="Репозиторий карт" />
                                    <TextBox Text="{Binding Timeline.MapRepositoryUrl}" Watermark="Ссылка на репозиторий GitHub"
                                             IsEnabled="{Binding !Timeline.IsMapToolsBusy}" />
                                    <Button Content="Включить и скачать" Command="{Binding EnableMapToolsCommand}"
                                            IsVisible="{Binding !Timeline.AreMapsReady}" IsEnabled="{Binding !Timeline.IsMapToolsBusy}" />
                                    <Button Content="Удалить инструменты карт" Command="{Binding RemoveMapToolsCommand}"
                                            IsVisible="{Binding HasMapTools}"
                                            ToolTip.Tip="Удалить кеш, исходники, нарезку карт и скачанные инструменты" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding !Timeline.AreMapsReady}" IsEnabled="{Binding !IsRemovingMapTools}">
                    <Button Content="Включить и скачать" Command="{Binding EnableMapToolsCommand}"
                            IsEnabled="{Binding !IsRemovingMapTools}" IsVisible="{Binding !Timeline.IsMapToolsBusy}" />
                    <Button Content="Отмена" Command="{Binding Timeline.CancelMapToolsCommand}"
                            IsVisible="{Binding Timeline.IsMapToolsBusy}" />
                </StackPanel>
                <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding Timeline.IsMapToolsBusy}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Content="↺" Command="{Binding Timeline.ResetTimeSliceCommand}" Padding="6,0"
                            ToolTip.Tip="Весь лог" IsEnabled="{Binding Timeline.CanSelectTime}" />
                <rs:RangeSlider Grid.Column="1" Minimum="0" Maximum="{Binding Timeline.SliderMaximum}"
                                LowerSelectedValue="{Binding Timeline.FromSecond, Mode=TwoWay}"
                                UpperSelectedValue="{Binding Timeline.ToSecond, Mode=TwoWay}"
                                TickFrequency="1" IsSnapToTickEnabled="True" IsThumbOverlap="True"
                                IsEnabled="{Binding Timeline.CanSelectTime}" />
                </Grid>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" ClipToBounds="True">
            <views:MapViewport x:Name="Viewport" Document="{Binding Document}"
                               FocusLocation="{Binding FocusLocation}" LogIndex="{Binding LogIndex}"
                               SelectedLayer="{Binding SelectedLayer}" Zoom="{Binding Zoom, Mode=TwoWay}" />
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                    Background="{DynamicResource AppPanelBrush}" CornerRadius="6" Padding="10">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding MapName}" Foreground="{DynamicResource AppTextBrush}" FontWeight="SemiBold" />
                    <Button Content="↑" Command="{Binding LayerUpCommand}" Width="34" Height="32"
                            HorizontalContentAlignment="Center" />
                    <TextBlock Text="{Binding SelectedLayer, StringFormat='Z: {0}'}" Foreground="{DynamicResource AppMutedTextBrush}" />
                    <Button Content="↓" Command="{Binding LayerDownCommand}" Width="34" Height="32"
                            HorizontalContentAlignment="Center" />
                </StackPanel>
            </Border>
            <Border IsVisible="{Binding HasSelectedPoint}" HorizontalAlignment="Right" Margin="12"
                    Width="400" Background="{DynamicResource AppPanelBrush}" Padding="12" CornerRadius="6">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                        <TextBlock Text="{Binding SelectedPoint.Name}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0"
                                    ToolTip.Tip="Диапазон захвата времени вокруг записи">
                            <TextBlock Text="±" VerticalAlignment="Center" />
                            <NumericUpDown Value="{Binding TimeCaptureRadius, Mode=TwoWay}" Minimum="0" Maximum="3600"
                                           Increment="1" FormatString="0" Width="130" Height="32" MinHeight="0"
                                           Padding="6,0" VerticalContentAlignment="Center" />
                            <TextBlock Text="с" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="×" Command="{Binding ClosePointCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding PointEntries}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogEntryViewModel">
                                <StackPanel Margin="0,2" Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding TimeLabel}" />
                                        <TextBlock Text="{Binding Entry.Type}" Foreground="{Binding TypeColor}" />
                                        <TextBlock Text="{Binding ChannelLabel}" Foreground="{Binding ChannelColor}"
                                                   IsVisible="{Binding HasChannel}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="◷" Padding="4,0" Margin="6,0,0,0"
                                            ToolTip.Tip="Показать выбранный диапазон времени вокруг записи"
                                            Command="{Binding $parent[Window].((vm:MapViewModel)DataContext).FocusLogTimeCommand}"
                                            CommandParameter="{Binding}" />
                                    </Grid>
                                    <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border IsVisible="{Binding Timeline.HasMapToolsStatus}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="12" Padding="10,6" CornerRadius="6" Background="{DynamicResource MapStatusPanelBrush}"
                    MaxWidth="650" IsHitTestVisible="False">
                <TextBlock Text="{Binding Timeline.MapToolsStatus}" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextBrush}" />
            </Border>
            <Border IsVisible="{Binding HasStatus}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="16" Padding="12" CornerRadius="6" Background="{DynamicResource AppPanelBrush}" MaxWidth="650">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AppTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
