<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Loggepector.App"
             xmlns:local="using:Loggepector"
             xmlns:rangeThemes="using:RangeSlider.Avalonia.Themes.Fluent"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <rangeThemes:RangeSliderTheme />
        <StyleInclude Source="/Styles/Themes.axaml" />
    </Application.Styles>
</Application>